# AWS credentials – choose ONE of the two options below.
#
# Option A: Named profile (recommended if you use the AWS CLI / SSO)
#   1. Run:  aws sso login --profile <your-profile>
#   2. Set:
# AWS_PROFILE=tr-reuters-devops-sandbox
# AWS_DEFAULT_REGION=eu-west-1

# Option B: Explicit access keys (for CI/CD or users without the AWS CLI)
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_SESSION_TOKEN=xxxxxx   # only needed for temporary/STS credentials
# AWS_DEFAULT_REGION=eu-west-1

# ── Docker usage ─────────────────────────────────────────────────────────────
# Option A (mount your local AWS config — read-only):
#   docker run -v ~/.aws:/root/.aws:ro -e AWS_PROFILE -e AWS_DEFAULT_REGION \
#              your-image --video s3://bucket/path/video.mp4
#
# Option B (pass keys directly):
#   docker run -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY \
#              -e AWS_DEFAULT_REGION your-image --video s3://bucket/path/video.mp4
